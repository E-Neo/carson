package carson:agent;

interface events {
    record part {
        kind: string,
        data: string,
    }

    enum event-error {
        closed,
    }

    emit-event: func(session-id: string, part: part) -> result<_, event-error>;
    cancelled: func(session-id: string) -> bool;

    /// Host wall-clock time in milliseconds since the unix epoch. The sandbox
    /// has no clock of its own, so blocks stamp their timestamps through this.
    now-ms: func() -> u64;
}

interface llm {
    record message {
        role: string,
        content: option<string>,
        tool-calls: option<list<tool-call>>,
        tool-call-id: option<string>,
    }

    record tool-definition {
        name: string,
        description: string,
        parameters-json: string,
    }

    record tool-call {
        id: string,
        name: string,
        arguments-json: string,
    }

    record request {
        session-id: string,
        model: string,
        messages: list<message>,
        system-prompt: option<string>,
        tools: list<tool-definition>,
        temperature: option<f32>,
        max-tokens: option<u32>,
    }

    record usage {
        input-tokens: u32,
        cache-read-tokens: u32,
        cache-creation-tokens: u32,
        output-tokens: u32,
    }

    record chunk {
        text: option<string>,
        thinking: option<string>,
        tool-call-start: option<tool-call>,
        tool-call-end: option<tool-call>,
    }

    variant llm-error {
        network,
        auth,
        rate-limited,
        timeout,
        cancelled,
        /// Carries a human-readable explanation of the failure.
        internal(string),
    }

    stream-start: func(request: request) -> result<u64, llm-error>;
    stream-next: func(handle: u64) -> result<option<chunk>, llm-error>;
    stream-usage: func(handle: u64) -> result<usage, llm-error>;
    stream-close: func(handle: u64) -> result<_, llm-error>;
}

interface tools {
    use llm.{tool-definition};

    enum tool-error {
        not-found,
        permission-denied,
        failed,
    }

    list-tools: func() -> list<tool-definition>;
    invoke: func(name: string, arguments-json: string) -> result<string, tool-error>;
}

interface agent {
    use llm.{message, usage};

    record session-config {
        system-prompt: string,
        model: string,
        capabilities-json: string,
        max-history: u32,
        context-window: u32,
        compaction-ratio: f32,
        auto-compact: bool,
    }

    /// One entry of the ordered conversation log.
    ///
    /// `kind` is one of "user", "thinking", "text", "tool-use", "tool-result"
    /// or "system". Token counters carry the usage of the LLM call that
    /// produced the block (zero for user/tool-result entries).
    record block {
        kind: string,
        text: option<string>,
        tool-call-id: option<string>,
        tool-name: option<string>,
        arguments-json: option<string>,
        is-error: bool,
        input-tokens: u32,
        cache-read-tokens: u32,
        cache-creation-tokens: u32,
        output-tokens: u32,
        created-at-ms: u64,
        finished-at-ms: u64,
    }

    record state {
        blocks: list<block>,
        summary: option<string>,
        usage: usage,
    }

    enum error {
        not-found,
        busy,
        internal,
    }

    create-session: func(session-id: string, config: session-config) -> result<_, error>;
    restore-session: func(session-id: string, config: session-config, state: state) -> result<_, error>;
    session-history: func(session-id: string) -> result<list<block>, error>;
    session-usage: func(session-id: string) -> result<usage, error>;
    session-state: func(session-id: string) -> result<state, error>;
    compact-session: func(session-id: string) -> result<_, error>;
    reset-session: func(session-id: string) -> result<_, error>;
    handle-message: func(session-id: string, message: string) -> result<_, error>;
    destroy-session: func(session-id: string) -> result<_, error>;
}

world agent-world {
    import events;
    import llm;
    import tools;
    export agent;
}
